{
  "extensionName": { "message": "Job Feed Filter" },
  "extensionDescription": { "message": "Hide companies from LinkedIn Jobs search results. Fully local — name list, optional keyword rules, whitelist." },

  "popup_title": { "message": "Job Feed Filter" },
  "popup_blocked_label": { "message": "hidden on this page" },
  "popup_show_all": { "message": "Show all on this tab" },
