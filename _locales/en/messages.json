  "popup_login_required": { "message": "Sign in to LinkedIn to start filtering." },
  "popup_login_link": { "message": "Open LinkedIn" },

  "options_subtitle": { "message": "Hide companies you don't want to see in your job search" },

  "tab_blacklist": { "message": "Hide list" },
  "tab_keywords": { "message": "Keywords" },
  "tab_whitelist": { "message": "Always show" },
  "tab_io": { "message": "Import / Export" },

  "blacklist_hint": { "message": "Companies on this list will be hidden. Matching is case-insensitive and ignores legal-form suffixes (Inc., Ltd., 株式会社)." },
  "blacklist_placeholder": { "message": "Add a company name" },

  "keywords_hint": { "message": "Any company whose name contains a keyword will be hidden. May cause false positives — pair with the 'Always show' list." },
